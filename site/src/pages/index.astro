---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBasePath } from "@/lib/urls";

const docsHref = (slug: string) => withBasePath(`/${slug}/`);
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 max-w-xl text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>

      <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={docsHref("getting-started")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Get started</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Install and connect the GitHub App</div>
        </a>
        <a
          href={docsHref("slash-config-reference")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Configure commands</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Define arguments and permissions</div>
        </a>
        <a
          href={docsHref("test-engine")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Test Engine</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Collect results and quarantine flaky tests</div>
        </a>
        <a
          href={docsHref("grants")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Grants</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Authorize users and teams to invoke commands</div>
        </a>
        <a
          href={docsHref("deployment")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Deploy Slash</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Run the server and Postgres</div>
        </a>
        <a
          href={docsHref("api")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">API reference</div>
          <div class="mt-0.5 text-sm text-muted-foreground">Integrate with every server endpoint</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
