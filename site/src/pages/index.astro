---
import { config } from "virtual:nimbus/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalePath, LOCALE_STORAGE_KEY } from "@/lib/i18n";
import { basePath, siteUrl } from "@/lib/urls";

const englishHref = getLocalePath("/", "en", basePath);
const simplifiedChineseHref = getLocalePath("/", "zh-Hans", basePath);
const head = [
  { tag: "link" as const, attrs: { rel: "alternate", hreflang: "en", href: siteUrl(englishHref) } },
  { tag: "link" as const, attrs: { rel: "alternate", hreflang: "zh-Hans", href: siteUrl(simplifiedChineseHref) } },
  { tag: "link" as const, attrs: { rel: "alternate", hreflang: "x-default", href: siteUrl("/") } },
];
---

<BaseLayout title={config.title} description={config.description} lang="en" head={head}>
  <main id="main-content" class="grid min-h-screen place-items-center px-6 py-16">
    <div class="w-full max-w-md text-center">
      <svg class="mx-auto h-10 w-10" viewBox="0 0 256 256" fill="none" aria-hidden="true">
        <polygon class="fill-foreground" points="148,20 198,20 108,236 58,236" />
      </svg>
      <h1 class="mt-6 text-2xl font-semibold text-foreground">Choose your language</h1>
      <p class="mt-2 text-sm text-muted-foreground">选择你的语言</p>
      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={englishHref}
          lang="en"
          data-root-locale="en"
          class="rounded-lg border border-border px-4 py-3 font-medium text-foreground no-underline transition-colors hover:border-border-strong hover:bg-accent"
        >English</a>
        <a
          href={simplifiedChineseHref}
          lang="zh-Hans"
          data-root-locale="zh-Hans"
          class="rounded-lg border border-border px-4 py-3 font-medium text-foreground no-underline transition-colors hover:border-border-strong hover:bg-accent"
        >简体中文</a>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ englishHref, simplifiedChineseHref, localeStorageKey: LOCALE_STORAGE_KEY }}>
    (() => {
      const destinations = { en: englishHref, "zh-Hans": simplifiedChineseHref };
      const stored = localStorage.getItem(localeStorageKey);
      const preferred = stored === "en" || stored === "zh-Hans"
        ? stored
        : navigator.languages.some((language) => language.toLowerCase().startsWith("zh"))
          ? "zh-Hans"
          : "en";

      document.querySelectorAll("[data-root-locale]").forEach((link) => {
        link.addEventListener("click", () => {
          localStorage.setItem(localeStorageKey, link.dataset.rootLocale);
        });
      });

      window.location.replace(destinations[preferred]);
    })();
  </script>
</BaseLayout>
