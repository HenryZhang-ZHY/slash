---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBasePath } from "@/lib/urls";

const docsHref = (slug: string) => withBasePath(`/zh/${slug}/`);
---

<BaseLayout title={config.title} description={config.description} lang="zh">
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 max-w-xl text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>

      <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={docsHref("getting-started")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">快速开始</div>
          <div class="mt-0.5 text-sm text-muted-foreground">安装并连接 GitHub App</div>
        </a>
        <a
          href={docsHref("slash-config-reference")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">配置命令</div>
          <div class="mt-0.5 text-sm text-muted-foreground">定义参数与权限</div>
        </a>
        <a
          href={docsHref("test-engine")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">Test Engine</div>
          <div class="mt-0.5 text-sm text-muted-foreground">收集测试结果并隔离 flaky 测试</div>
        </a>
        <a
          href={docsHref("grants")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">权限授权（Grants）</div>
          <div class="mt-0.5 text-sm text-muted-foreground">授权用户和团队调用命令</div>
        </a>
        <a
          href={docsHref("deployment")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">部署 Slash</div>
          <div class="mt-0.5 text-sm text-muted-foreground">运行服务器与 Postgres</div>
        </a>
        <a
          href={docsHref("api")}
          class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">API 参考</div>
          <div class="mt-0.5 text-sm text-muted-foreground">接入全部服务端接口</div>
        </a>
      </div>
    </main>
  </div>
</BaseLayout>
