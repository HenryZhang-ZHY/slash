# CI toolchain image for Buildkite. No source is copied in — the docker-
# compose-buildkite-plugin bind-mounts the checkout at run time (see
# pipeline.yml's `mount-checkout`) — this just needs the same native build
# deps as the root Dockerfile's builder stage (`ring`/`aws-lc-rs`, pulled in
# transitively by rustls, build C code the slim image has no compiler for)
# plus the rustfmt/clippy components the slim image's default profile omits.
#
# Tracks current stable rather than pinning to Cargo.toml's declared
# rust-version (1.85), matching .github/workflows/ci.yml's
# dtolnay/rust-toolchain@stable — Cargo.lock has resolved some transitive
# deps (cargo_metadata, time and friends) against a newer rustc than 1.85
# already supports, so pinning to 1.85 here fails dependency resolution.
FROM rust:slim-bookworm

ENV CARGO_TERM_COLOR=always

# buildkite-test-collector is baked into the image rather than installed
# per-run — it's a compiled crate with its own build time, and the `test`
# step image is rebuilt (not reused) whenever this file changes anyway.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy \
    && cargo install buildkite-test-collector
